+
+/// Append one JSON object per call to `cfg.events_file`.
+///
+/// The text trace is for a human and changes shape with verbosity; this is the
+/// structure the sandbox pack reads. Escaped by hand so the hot path does not
+/// pull a serializer into every API call.
+fn emit_json(emu: &Emu, kind: &str, name: &str, arguments: &str, result: &str) {
+    let Some(path) = emu.cfg.events_file.as_ref() else {
+        return;
+    };
+    fn escape(text: &str) -> String {
+        let mut out = String::with_capacity(text.len() + 8);
+        for character in text.chars() {
+            match character {
+                '"' => out.push_str("\\\""),
+                '\\' => out.push_str("\\\\"),
+                '\n' => out.push_str("\\n"),
+                '\r' => out.push_str("\\r"),
+                '\t' => out.push_str("\\t"),
+                c if (c as u32) < 0x20 => out.push_str(&format!("\\u{:04x}", c as u32)),
+                c => out.push(c),
+            }
+        }
+        out
+    }
+    let line = format!(
+        "{{\"kind\":\"{}\",\"api\":\"{}\",\"arguments\":\"{}\",\"result\":\"{}\"}}\n",
+        escape(kind), escape(name), escape(arguments), escape(result)
+    );
+    if let Ok(mut file) = std::fs::OpenOptions::new().create(true).append(true).open(path) {
+        let _ = std::io::Write::write_all(&mut file, line.as_bytes());
+    }
+}
