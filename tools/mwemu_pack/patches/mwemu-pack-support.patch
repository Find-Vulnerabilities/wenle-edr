index a6a89d0..c0d45ac 100644
--- a/crates/libmwemu/src/api/windows/registry_store.rs
+++ b/crates/libmwemu/src/api/windows/registry_store.rs
@@ -217,6 +217,38 @@ impl Default for Registry {
 }
 
 impl Registry {
+    /// Seed the store from a text snapshot.
+    ///
+    /// One value per line: `key|name|type|data`, `#` starts a comment. Types are
+    /// `sz` and `dword`; a line with no name sets the key's default value. The
+    /// store starts with the predefined roots, so a snapshot adds what a real
+    /// machine has under them without touching the host registry.
+    pub fn load_snapshot(&mut self, path: &std::path::Path) -> std::io::Result<usize> {
+        let text = std::fs::read_to_string(path)?;
+        let mut loaded = 0;
+        for line in text.lines() {
+            let line = line.trim();
+            if line.is_empty() || line.starts_with('#') {
+                continue;
+            }
+            let mut parts = line.split('|');
+            let Some(key) = parts.next().map(str::trim).filter(|key| !key.is_empty()) else {
+                continue;
+            };
+            let name = parts.next().unwrap_or("").trim();
+            let kind = parts.next().unwrap_or("sz").trim();
+            let data = parts.next().unwrap_or("").trim();
+            self.create_key(key);
+            let value = match kind {
+                "dword" => dword(data.parse::<u32>().unwrap_or(0)),
+                _ => sz(data),
+            };
+            self.set_value(key, name, value);
+            loaded += 1;
+        }
+        Ok(loaded)
+    }
+
     pub fn key_exists(&self, path: &str) -> bool {
         find(&self.keys, path).is_some()
     }
